# Dependencies
node_modules/
.pnpm-store/

# Frontend build output
/dist/
/dist-ssr/
/build/
*.tsbuildinfo

# Rust / Tauri build output
/target/
/src-tauri/target/
/src-tauri/gen/schemas/

# Environment files and local overrides
.env
.env.*
!.env.example
!.env.template
*.local

# Tauri signing material — never commit private keys or certificates.
