# Dependencies
node_modules/
.pnpm-store/

# Frontend build output
/dist/
/dist-ssr/
/build/
*.tsbuildinfo

# Rust / Tauri build output
/target/
/src-tauri/target/
/src-tauri/gen/schemas/

# Environment files and local overrides
.env
.env.*
!.env.example
!.env.template
*.local

# Tauri signing material — never commit private keys or certificates.
/src-tauri/.tauri-updater-key
*.p12
*.pfx

# Logs, reports, coverage, and temporary files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/
.cache/
.tmp/
tmp/

# Generated release artifacts
/release/
/artifacts/
*.AppImage
*.deb
*.dmg
*.msi
*.rpm

# Python helpers used by the asset-generation scripts
__pycache__/
*.py[cod]
.venv/
venv/

# Codex local state (sessions, logs). Keep the shared environment file.
.codex/*
!.codex/environments/
.codex/environments/*
!.codex/environments/environment.toml

# Your personal project list. In dev (`pnpm tauri dev`) VibeRunner uses a
# vibe.config.json found by walking up from the working directory; the
# installed app keeps it in its app-data folder instead.
/vibe.config.json

# Editor / agent directories and operating-system files
.vscode/
.claude/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
