logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/
.cache/
.tmp/
tmp/

# Generated release artifacts
/release/
/artifacts/
*.AppImage
*.deb
*.dmg
*.msi
*.rpm

# Python helpers used by the asset-generation scripts
__pycache__/
*.py[cod]
.venv/
venv/

